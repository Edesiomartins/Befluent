APP_ENV=development
ENVIRONMENT=development
APP_NAME=BeFluent
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Produção (Coolify) — obrigatório para go-live:
# ENVIRONMENT=production
# FRONTEND_URL=https://befluent.medquesthub.com.br
# FRONTEND_ORIGIN=https://befluent.medquesthub.com.br
# NEXT_PUBLIC_API_URL=https://api-befluent.medquesthub.com.br
# SESSION_SECURE=true
# COOKIE_DOMAIN=.medquesthub.com.br
# SESSION_COOKIE_NAME=befluent_session
# AI_MOCK_MODE=false
# STT_PROVIDER=groq

POSTGRES_USER=befluent
POSTGRES_PASSWORD=
POSTGRES_DB=befluent
# Use postgresql+psycopg:// (não postgres:// — SQLAlchemy rejeita o dialeto legado)
DATABASE_URL=postgresql+psycopg://befluent:CHANGE_ME@localhost:5432/befluent

SESSION_SECRET=
SESSION_COOKIE_NAME=befluent_session
# Compatibilidade: se o Coolify ainda usar fluentia_session, defina SESSION_COOKIE_NAME=fluentia_session
# (o backend aceita SESSION_COOKIE_NAME ou COOKIE_NAME).
SESSION_DAYS=30
# SESSION_SECURE / COOKIE_SECURE são aliases (mesmo campo no backend).
SESSION_SECURE=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Em produção com FE e API em subdomínios (befluent.* e api-befluent.*):
# COOKIE_DOMAIN=.medquesthub.com.br
# SESSION_SECURE=true
CSRF_COOKIE_NAME=csrf_token

INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- IA (OpenRouter) ---
AI_MOCK_MODE=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- STT ---
# STT_PROVIDER=mock | groq
# Em produção, mock silencioso está proibido: falha real → 503 stt_unavailable.
STT_PROVIDER=mock
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
STT_FALLBACK_PROVIDER=openrouter
STT_FALLBACK_MODEL=qwen/qwen3-asr-flash-2026-02-10
# Legadas / não usadas pelo factory atual (mantidas só se algum deploy antigo as referenciar):
# STT_API_KEY=
# STT_MODEL=

MAX_AUDIO_BYTES=10000000
MAX_AUDIO_DURATION_SECONDS=120
# Nomes legados (não lidos pelo Settings atual):
# MAX_AUDIO_MB=10
# MAX_AUDIO_SECONDS=120

# --- TTS ---
# Nenhum TTS pago no servidor nesta fase. O frontend usa SpeechSynthesis do navegador.
# TTS_PROVIDER=mock só libera WAV stub fora de produção; em production o endpoint responde 503.
TTS_PROVIDER=mock
# Legadas / não usadas pelo TTS real (ainda não há provedor de servidor):
# TTS_API_KEY=
# TTS_VOICE=
# TTS_SPEED=1.0

# CORS: o backend usa FRONTEND_ORIGIN (não CORS_ORIGINS).
# CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO
# SRS_SCHEDULER=simple  — documentado historicamente; não há campo Settings correspondente.
