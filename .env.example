APP_ENV=development
APP_NAME=BeFluent
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Produção (Coolify) — obrigatório para go-live:
# APP_ENV=production
# FRONTEND_URL=https://befluent.medquesthub.com.br
# FRONTEND_ORIGIN=https://befluent.medquesthub.com.br
# CORS_ORIGINS=https://befluent.medquesthub.com.br
# NEXT_PUBLIC_API_URL=https://api-befluent.medquesthub.com.br
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.medquesthub.com.br
# SESSION_COOKIE_NAME=befluent_session
# AI_MOCK_MODE=false
# OPENROUTER_API_KEY=...
# OPENROUTER_MODEL=...

POSTGRES_USER=befluent
POSTGRES_PASSWORD=
POSTGRES_DB=befluent
# Use postgresql+psycopg:// (não postgres:// — SQLAlchemy rejeita o dialeto legado)
DATABASE_URL=postgresql+psycopg://befluent:CHANGE_ME@localhost:5432/befluent

SESSION_SECRET=
SESSION_COOKIE_NAME=befluent_session
# Compatibilidade: se o Coolify ainda usar fluentia_session, defina SESSION_COOKIE_NAME=fluentia_session
# (o backend aceita SESSION_COOKIE_NAME ou COOKIE_NAME).
SESSION_DAYS=30
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MOCK_MODE=true

STT_PROVIDER=mock
STT_API_KEY=
STT_MODEL=
MAX_AUDIO_MB=10
MAX_AUDIO_SECONDS=120

TTS_PROVIDER=mock
TTS_API_KEY=
TTS_VOICE=
TTS_SPEED=1.0

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Em produção com FE e API em subdomínios (befluent.* e api-befluent.*):
# COOKIE_DOMAIN=.medquesthub.com.br
# COOKIE_SECURE=true
CSRF_COOKIE_NAME=csrf_token

CORS_ORIGINS=http://localhost:3000

SRS_SCHEDULER=simple
LOG_LEVEL=INFO
