ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://befluent:CHANGE_ME@localhost:5432/befluent
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
SESSION_COOKIE_NAME=befluent_session
SESSION_SECURE=false
COOKIE_SECURE=false
# Produção cross-subdomínio: COOKIE_DOMAIN=.medquesthub.com.br
COOKIE_SAMESITE=lax
AI_MOCK_MODE=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# STT: STT_PROVIDER=groq usa Groq (GROQ_API_KEY + GROQ_STT_MODEL) como primário;
# STT_FALLBACK_PROVIDER=openrouter usa STT_FALLBACK_MODEL via OpenRouter se o primário falhar.
# STT_PROVIDER=mock é só para desenvolvimento/teste. Em production, falha → 503.
STT_PROVIDER=mock
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
STT_FALLBACK_PROVIDER=openrouter
STT_FALLBACK_MODEL=qwen/qwen3-asr-flash-2026-02-10
# TTS: TTS_PROVIDER=openrouter usa Kokoro-82M (hexgrad/kokoro-82m) via OpenRouter
# (mesma OPENROUTER_API_KEY acima); TTS_VOICE forca uma voz unica se definido.
# TTS_PROVIDER=mock so libera stub fora de production; em production sem provider
# real configurado, /speech/synthesize responde 503.
TTS_PROVIDER=mock
TTS_MODEL=hexgrad/kokoro-82m
TTS_VOICE=
TTS_SPEED=1.0
MAX_AUDIO_BYTES=10000000
MAX_AUDIO_DURATION_SECONDS=120
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrador
# TTS Lab (/admin/tts-lab): ferramenta interna temporária de comparação de
# modelos de TTS, isolada do TTS_PROVIDER de produção acima. Lista vazia =
# ninguém acessa. Ver docs/TTS_LAB.md.
TTS_LAB_ALLOWED_EMAILS=
# Resend (e-mail de "esqueci minha senha"): sem RESEND_API_KEY, o link não é
# enviado (forgot-password ainda responde com sucesso genérico, mas loga aviso).
# RESEND_FROM_EMAIL precisa ser um domínio verificado no Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@medquesthub.com.br
PASSWORD_RESET_TOKEN_MINUTES=30
